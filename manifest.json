{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["content/superpower.css"],
      "js": [
        "content/modules/i18n.js",
        "content/modules/themeSync.js",
        "content/modules/autoFocus.js",
        "content/modules/wideMode.js",
        "content/modules/usageTracker.js",
        "content/modules/navigator.js",
        "content/modules/promptCommands.js",
        "content/modules/bulkDelete.js",
        "content/modules/toolbar.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
